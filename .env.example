# Токен бота от @BotFather
BOT_TOKEN=123456789:REPLACE_ME

# Telegram user_id администраторов через запятую.
# Узнать свой ID можно через @userinfobot или аналогичный сервис.
ADMIN_IDS=123456789

# Путь к SQLite внутри контейнера. Обычно менять не нужно.
DATABASE_PATH=/data/bot.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Локальная status/health страница внутри контейнера
STATUS_PORT=8080

# Клиентское время и календарь (IANA timezone)
TZ=Europe/Moscow

# Web Admin: http://IP_ZIMAOS:18080/admin
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Дополнительные пользователи: login:password:role
# Роли: owner, manager, viewer. Не используйте двоеточие в логине/пароле.
WEB_ADMIN_USERS=manager1:StrongPassword123:manager,viewer1:AnotherPassword123:viewer

# Ограничение одновременно обрабатываемых Telegram updates
MAX_CONCURRENT_UPDATES=32

# Резервные копии внутри постоянного /data volume
BACKUP_DIR=/data/backups

# 1 = безопасный тест с реальными формами без создания CRM-заявок
STAGING_MODE=0

# Необязательная подготовка будущей миграции; runtime v2.2.0 использует SQLite
POSTGRES_DSN=
